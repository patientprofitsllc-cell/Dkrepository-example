# Node >=24. SQLite requires a persistent local volume; use a single app instance.
DATABASE_PATH=.data/dk.sqlite
APP_URL=http://localhost:3000
# Set a unique random value of at least 32 characters; never commit real values.
SESSION_SECRET=
# Generate hashes with: npm run hash-password -- 'your-password'
ADMIN_PASSWORD_HASH=
STAFF_PASSWORD_HASH=
VIEWER_PASSWORD_HASH=
# Optional inbound webhook adapters. Leave empty until integration is reviewed.
VAPI_WEBHOOK_SECRET=
RETELL_WEBHOOK_SECRET=
TWILIO_AUTH_TOKEN=
# No outbound toggle is implemented. Outbound is unconditionally blocked.
